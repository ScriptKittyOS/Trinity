<Layouts.app flash={@flash}>
  <:bar>
    <span class="opacity-70">{gettext("Sign in")}</span>
  </:bar>
  <div id="token-login" class="mx-auto flex max-w-md flex-col gap-4 px-4 py-8">
    <p class="text-ui opacity-80">
      {gettext(
        "This Trinity is shared with a token, not with accounts. Whoever holds the token is the owner here: there is no per-user identity, and the receipts say so."
      )}
    </p>
    <.form
      for={%{}}
      as={:secret}
      action={~p"/auth/token"}
      method="post"
      class="flex flex-col gap-2"
    >
      <input
        type="password"
        name="secret"
        autocomplete="off"
        class="input input-bordered w-full"
        aria-label={gettext("Token")}
      />
      <button type="submit" class="btn btn-sm btn-primary">{gettext("Sign in")}</button>
    </.form>
  </div>
</Layouts.app>
