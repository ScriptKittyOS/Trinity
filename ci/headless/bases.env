#
# The bases of the headless image this project publishes, as build arguments for
# ci/ironbank/Dockerfile (slice 130). Iron Bank builds the same file with its own registry and
# the tags in hardening_manifest.yaml; this build pins every base by digest instead, through the
# tag argument, so a base change is a diff here and never a silent drift under a moving tag.
# `test/ironbank_submission_test.exs` resolves every FROM in the Dockerfile against this file and
# fails on one that does not carry a digest.
#
# Both digests are the ones Iron Bank's own UBI 9.8 images declare as their sources
# (dsop/redhat/ubi/9.x/ubi9-micro and .../ubi9, hardening_manifest.yaml, read 2026-10-08), so
# this build and theirs start from the same bytes.
BASE_REGISTRY=registry.access.redhat.com
BASE_IMAGE=ubi9/ubi-micro
BASE_TAG=9.8@sha256:932aec77f5b86a5dba854a18b14a38725b296967e7dc9c7a1f4d7f0bf82e1ce5
BUILDER_IMAGE=ubi9
BUILDER_TAG=9.8@sha256:c26665a762876d5de27d1ed50e029ab3bc80ef3a3e155824ee7ab43e70055b63
