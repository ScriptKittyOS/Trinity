# The FIPS build leg's image (slice 003, docs/fips-leg.md): OTP built from source with
# --enable-fips against the OpenSSL of a UBI9 container, whose FIPS provider is the one Red Hat
# publishes a validation for, plus Elixir and everything `mix gate` shells out to. The gate
# leg pulls this image; nothing here runs Trinity.
#
# The versions arrive as build arguments read from .tool-versions by the image workflow, so
# that file stays the one source. The two archives are checked against digests pinned here;
# a new OTP or Elixir pin is a new pair of digests in this file, read from the release page.
#
# Base pinned by digest, not tag: registry.access.redhat.com/ubi9/ubi:latest resolved on
# 2026-09-20 (Red Hat Enterprise Linux release 9.8, openssl-libs 3.5.8-1.el9_8, FIPS provider
# 3.0.7). A base change is a diff here and a rebuild, never a silent drift under a moving tag.
FROM registry.access.redhat.com/ubi9/ubi@sha256:9295c5c688f487fa5cf27a734fa55ecd57aeb7dc0904ba537da4f42dfa1d0acb

ARG OTP_VERSION
ARG ELIXIR_VERSION
ARG OTP_SHA256=5231ba18f31f8041c2d6514cc8842e46954d3b39a53f1617f03f2abe6fea59c7
ARG ELIXIR_SHA256=ea7ff98bc1ed76c663a5d034c863c6fd37e65c9c855b6bbf6ccb2034d806673c

# The toolchain OTP's configure needs, plus what the gate's steps call from the shell: git
# (plan_check, the names and secrets census), python3 with PyYAML (plan_check rule 12), gcc
# (exqlite compiles SQLite; mdex_native's precompiled artifact loads on glibc), procps-ng (the
# shell tool's tests read `ps`). Kept in the image on purpose: it is a CI image, not a runtime.
RUN dnf -y install --setopt=install_weak_deps=False \
      gcc gcc-c++ make autoconf ncurses-devel openssl-devel \
      tar gzip unzip git python3-pyyaml procps-ng which \
    && dnf clean all

# OTP from source. --enable-fips compiles the crypto NIF's FIPS support; --with-ssl points at
# the distribution's OpenSSL and its dynamic library, which is where the validated provider
# lives, so the link is dynamic by design (a static OpenSSL would carry no FIPS provider).
# Applications with no place on a CI leg are left out to shorten the build.
RUN set -eu; \
    curl -fsSLo /tmp/otp.tar.gz \
      "https://github.com/erlang/otp/releases/download/OTP-${OTP_VERSION}/otp_src_${OTP_VERSION}.tar.gz"; \
    echo "${OTP_SHA256}  /tmp/otp.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/otp && tar -xzf /tmp/otp.tar.gz -C /tmp/otp --strip-components=1; \
    cd /tmp/otp; \
    ./configure --prefix=/usr/local --enable-fips --with-ssl=/usr \
      --without-javac --without-jinterface --without-wx --without-odbc \
      --without-debugger --without-observer --without-et --without-megaco; \
    make -j"$(nproc)"; \
    make install; \
    rm -rf /tmp/otp /tmp/otp.tar.gz

# Elixir, precompiled for this OTP major (the release's own zip and its published digest).
RUN set -eu; \
    curl -fsSLo /tmp/elixir.zip \
      "https://github.com/elixir-lang/elixir/releases/download/v${ELIXIR_VERSION}/elixir-otp-28.zip"; \
    echo "${ELIXIR_SHA256}  /tmp/elixir.zip" | sha256sum -c -; \
    mkdir -p /usr/local/elixir && unzip -q /tmp/elixir.zip -d /usr/local/elixir; \
    rm -f /tmp/elixir.zip

# Hex and rebar in a path that does not depend on HOME: a GitHub container job sets HOME to
# /github/home, and an install under /root would be invisible there.
ENV PATH=/usr/local/elixir/bin:/usr/local/bin:$PATH \
    LANG=C.UTF-8 \
    MIX_HOME=/opt/mix \
    HEX_HOME=/opt/hex
RUN mix local.hex --force && mix local.rebar --force

# The image proves its own build: the crypto NIF reports the FIPS provider available, and
# entering FIPS mode is possible. Which mode a container runs in is the leg's decision, made
# by OPENSSL_FORCE_FIPS_MODE and `-crypto fips_mode true` at run time, never here.
RUN erl -noshell -eval \
      'true = maps:get(fips_provider_available, crypto:info()), ok = crypto:enable_fips_mode(true), enabled = crypto:info_fips(), io:format("~p~n", [crypto:info()]), halt().' \
    && elixir --version
