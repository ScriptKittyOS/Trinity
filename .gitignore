# Secrets never enter history. CLAUDE.md §4 states this rule; this file is what makes it true.
.env
.env.*
!.env.example

# Build and dependency output
/_build/
/deps/
/cover/
/doc/
*.beam
erl_crash.dump

# Local data: the agent's own database and working state
/priv/data/
*.db
*.db-shm
*.db-wal

# Desktop shell (slices 001, 100, 101)
/tauri/target/
/priv/static/assets/

# Editor and OS noise
.elixir_ls/
.DS_Store

# Added by the Phoenix generator at slice 000, merged in rather than overwriting.
/.fetch
*.ez
/tmp/
trinity-*.tar
/priv/static/cache_manifest.json
npm-debug.log
/assets/node_modules/
*.db-*
